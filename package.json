{
  "name": "dsh-open-meadow",
  "version": "1.0.0-preview.3",
  "type": "module",
  "description": "海风与草甸：适用于深度求索工作台的动态海边主题",
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/KNOWN_ISSUES.md",
    "docs/ART_DIRECTION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "theme",
        "slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "preview": "node scripts/preview.mjs",
    "pack": "node scripts/pack.mjs",
    "check": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "test:motion": "node scripts/motion-test.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.0-rc.2"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhongyichang1998/dsh-open-meadow.git"
  },
  "homepage": "https://github.com/zhongyichang1998/dsh-open-meadow#readme",
  "bugs": {
    "url": "https://github.com/zhongyichang1998/dsh-open-meadow/issues"
  },
  "author": "zhongyichang1998",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "coastal",
    "meadow"
  ]
}
